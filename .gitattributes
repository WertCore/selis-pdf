# Binary artefacts must never be line-ending translated. With core.autocrlf=true
# on Windows checkouts, PDFs without this attribute were CRLF-smudged on
# checkout, shifting every byte offset after the first LF and breaking the
# byte-exact recovery fixtures (merge_recovery: outlines_for_editor.pdf).
*.pdf binary
*.png binary
*.ppm binary

# Fuzz seeds are libFuzzer corpus inputs: byte-exact, never EOL-translated
# (SL-1.ROB.02).
fuzz/seeds/** -text

# DER test fixtures (SL-1.ENC.03 PKCS#8 keys) are byte-exact binaries.
*.der binary
